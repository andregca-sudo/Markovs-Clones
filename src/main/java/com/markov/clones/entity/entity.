package com.markov.clones.entity;

import net.minecraft.core.Registry;
import net.minecraft.core.registries.BuiltInRegistries;
import net.minecraft.core.registries.Registries;
import net.minecraft.resources.ResourceKey;
import net.minecraft.world.entity.Entity;
import net.minecraft.world.entity.EntityType;
import net.minecraft.world.entity.MobCategory;
import net.fabricmc.fabric.api.object.builder.v1.entity.FabricDefaultAttributeRegistry;

import com.markov.clones.MarkovSClones;

public class ModEntityTypes {

    public static final ResourceKey<EntityType<?>> CLONE_KEY =
            ResourceKey.create(Registries.ENTITY_TYPE, MarkovSClones.id("clone"));

    public static final EntityType<CloneEntity> CLONE = Registry.register(
            BuiltInRegistries.ENTITY_TYPE,
            CLONE_KEY,
            EntityType.Builder.<CloneEntity>of(CloneEntity::new, MobCategory.CREATURE)
                    .sized(0.6f, 1.8f)
                    .build(CLONE_KEY)
    );

    public static void initialize() {
        FabricDefaultAttributeRegistry.register(
                CLONE,
                CloneEntity.createAttributes()
        );
    }
}
